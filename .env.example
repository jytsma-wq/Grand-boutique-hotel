# Public site configuration
NEXT_PUBLIC_SITE_URL=https://batumiboutique.com

# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
SANITY_WEBHOOK_SECRET=

# Database / Prisma
DATABASE_URL=file:./dev.db

# Contact form email
RESEND_API_KEY=
RESEND_FROM_EMAIL="Batumi Boutique Hotel <noreply@batumiboutique.com>"
HOTEL_EMAIL=

# Chatbot
GOOGLE_GEMINI_API_KEY=
# GEMINI_API_KEY can be used instead of GOOGLE_GEMINI_API_KEY.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
