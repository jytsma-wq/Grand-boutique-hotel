// Batumi Boutique Hotel - Prisma Schema
// For booking management and user reservations

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bookings  Booking[]
}

model Booking {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  roomId      String
  checkIn     DateTime
  checkOut    DateTime
  guests      Int
  totalPrice  Float
  status      String   @default("pending") // pending, confirmed, cancelled
  specialRequests String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Room {
  id          String   @id @default(cuid())
  name        String
  type        String
  capacity    Int
  pricePerNight Float
  available   Boolean  @default(true)
  amenities   String?
  description String?
  images      String?
  bookings    Booking[]
}
